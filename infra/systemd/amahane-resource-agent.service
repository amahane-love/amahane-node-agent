[Unit]
Description=Amahane resource server agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
ExecStart=/usr/local/bin/amahane-resource-agent
Restart=on-failure
RestartSec=10
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ProtectKernelTunables=true
ReadWritePaths=/etc /usr /var /run /var/lib/amahane-resource-agent /srv/amahane/backups

[Install]
WantedBy=multi-user.target
